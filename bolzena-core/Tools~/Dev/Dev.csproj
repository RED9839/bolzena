<Project Sdk="Microsoft.NET.Sdk">
  <!-- 개발용 콘솔 — 유니티 없이 코어를 빨리 돌려 본다(유니티는 이 폴더(Tools~)를 안 읽는다).
       유니티에 딸린 SDK: "C:\Program Files\Unity\Hub\Editor\6000.6.4f1\Editor\Data\DotNetSdk\dotnet.exe" run -c Release (명령) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414</NoWarn>
    <!-- 서버 GC — sim 은 스레드 27개가 동시에 판을 복사해 할당이 많다. 워크스테이션 GC 는 시간의 8할을 GC 멈춤으로 썼다(2026-10-09, sim 400 475초 중 396초). 결과는 같다. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
    <Compile Include="*.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>lib/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
