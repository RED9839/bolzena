    },
    "fx": {
     "$ref": "#/$defs/fxList"
    },
    "power": {
     "type": "boolean"
    },
    "countAs": {
     "type": "integer",
     "minimum": 0,
     "description": "천상 계기에서만 이 카드를 비용 N 으로 센다(▶E2)"
    },
    "type": {
     "enum": [
      "공격",
      "스킬",
      "강화"
     ],
     "description": "「스킬로」 · 「공격으로」 신탁 — 고르면 카드 종류가 이것으로"
    },
    "costIf": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "inHand": { "type": "string", "description": "이 카드 id 가 손에 있으면(이 카드 자신은 빼고)" },
      "add": { "type": "integer", "minimum": 1, "maximum": 3, "description": "비용 +N(기본 1)" }
     },
     "required": ["inHand"],
     "description": "이 신탁의 「손에 그 카드가 있으면 비용 +N」 — 카드의 costIf 를 물려받지 않는다(2026-10-13 이드)"
    },
    "needForm": {
     "type": "string",
     "description": "이 신탁을 얹으면 그 변신 · 태세 중에만 사용 가능"
    }
   },
   "required": [
    "name",
    "fx"
   ]
  },
  "bless": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "power",
      "cost",
      "weakSpot",
      "frost",
      "ap",
      "draw",
      "heal",
      "guard",
      "atkUp",
      "defUp"
     ]
    },
    "fx": {
     "$ref": "#/$defs/fxList"
    },
    "tags": {
     "$ref": "#/$defs/tags"
    }
   },
   "required": [
    "name"
   ]
  },
  "card": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[^~^]*$"
    },
    "name": {
     "type": "string"
    },
    "hero": {
     "type": "string"
    },
    "cost": {
     "type": "integer",
     "minimum": 0
    },
    "x": {
     "type": "boolean"
    },
    "bulletRatio": {
     "type": "number",
     "description": "탄환 추가 공격 배율(공격력 ×) — 0 이면 R.SV(탄환) · 「탄환」 카드에만(2026-10-13 시온)"
    },
    "type": {
     "enum": [
      "공격",
      "스킬",
      "강화",
      "상태",
      "저주"
     ]
    },
    "tags": {
     "$ref": "#/$defs/tags"
    },
    "fx": {
     "$ref": "#/$defs/fxList"
    },
    "unique": {
     "type": "boolean"
    },
    "signature": {
     "type": "boolean"
    },
    "oracles": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/oracle"
     },
     "minItems": 5,
     "maxItems": 5
    },
    "blesses": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/bless"
     },
     "maxItems": 3
    },
    "grade": {
     "enum": [
      "일반",
      "고급",
      "희귀",
      "전설"
     ]
    },
    "price": {
     "type": "integer"
    },
    "gift": {
     "type": "boolean"
    },
    "blurb": {
     "type": "string"
    },
    "token": {
     "type": "boolean",
     "description": "사도 전용 생성 카드(덱에 안 든다)"
    },
    "evolve": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "n": {
       "type": "integer",
       "minimum": 2
      },
      "into": {
       "type": "string"
      }
     },
     "required": [
      "into"
     ]
    },
    "complete": {
     "type": "boolean",
     "description": "완성형 — 신탁 없이 처음부터 완성된 고유 카드(2026-10-10)"
    },
    "bondCard": {
     "type": "string",
     "description": "결속 — 겹친 수 3 이상의 강해진 카드 id"
    },
    "becomes": {
     "type": "string",
     "description": "봉인된 금기 — 보스 처치 뒤 바뀔 금기 카드 id"
    },
    "payWith": {
     "type": "string",
     "description": "비용을 이 고유 효과(키워드) 겹으로"
    },
    "debt": {
     "type": "boolean",
     "description": "AP 가 모자라도 낸다(AP 빚)"
    },
    "choices": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "payRate": {
     "type": "integer",
     "minimum": 1
    },
    "payMix": {
     "type": "boolean"
    },
    "countAs": {
     "type": "integer",
     "minimum": 0,
     "description": "천상 계기에서만 이 카드를 비용 N 으로 센다(▶E2)"
    },
    "costIf": {
     "type": "object",
     "additionalProperties": false,
