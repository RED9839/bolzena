    },
    "ratio": {
     "type": "number",
     "description": "배율(1.2 = 120%)"
    },
    "target": {
     "anyOf": [
      {
       "enum": [
        "oneEnemy",
        "allEnemies",
        "randomEnemy",
        "topEnemy",
        "lowEnemy",
        "self",
        "oneAlly",
        "allAllies",
        "otherAllies",
        "party",
        "auto",
        "otherEnemy",
        "nextEnemy",
        "slowestEnemy",
        "markedEnemy",
        "strongestAlly",
        "farEnemy",
        "bigHitEnemy"
       ]
      },
      {
       "type": "string",
       "pattern": "^hero:"
      }
     ]
    },
    "id": {
     "type": "string",
     "description": "상태 이름 · 키워드 이름 · 만들 카드 id"
    },
    "hits": {
     "type": "integer",
     "minimum": 1
    },
    "n": {
     "type": "integer"
    },
    "turns": {
     "type": "integer",
     "minimum": 1
    },
    "run": {
     "type": "boolean",
     "description": "전투 내내"
    },
    "base": {
     "enum": [
      "def"
     ]
    },
    "fixed": {
     "type": "boolean"
    },
    "xHits": {
     "type": "boolean"
    },
    "xStack": {
     "type": "string"
    },
    "not": {
     "type": "boolean"
    },
    "type": {
     "enum": [
      "공격",
      "스킬",
      "강화",
      "상태",
      "저주"
     ]
    },
    "on": {
     "enum": [
      "draw",
      "drawAny",
      "discard",
      "handEnd",
      "burn",
      "passion",
      "handHurtBig",
      "shieldLeft"
     ]
    },
    "random": {
     "type": "boolean"
    },
    "per": {
     "type": "integer"
    },
    "pct": {
     "type": "number"
    },
    "dot": {
     "type": "boolean",
     "description": "dmg — 고정 지속 피해"
    },
    "to": {
     "type": "string",
     "description": "cardStatus: this · hand · draw / make: hand · draw · top · discard / pull: hand · top"
    },
    "from": {
     "type": "string",
     "description": "transform: 바꿀 카드 id / pull · exileFrom · ifPile · perPile: draw · discard · gone · hand"
    },
    "at": {
     "enum": [
      "top",
      "bottom",
      "random"
     ]
    },
    "max": {
     "type": "integer",
     "description": "ifStack 의 위 끝(n 이상 max 이하)"
    },
    "then": {
     "$ref": "#/$defs/fxList",
     "description": "later · afterCards · trap 안의 효과"
    },
    "who": {
     "type": "string",
     "description": "카드 거르개 — self · other · 사도 id"
    },
    "unique": {
     "type": "boolean"
    },
    "basic": {
     "type": "boolean"
    },
    "each": {
     "type": "boolean"
    },
    "battle": {
     "type": "boolean"
    },
    "tag": {
     "type": "string"
    },
    "ofEvent": {
     "type": "number"
    },
    "ofStack": {
     "type": "string"
    },
    "else": {
     "$ref": "#/$defs/fxList"
    },
    "rules": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/rule"
     },
     "description": "power — 강화 카드 지속 규칙(패시브 규칙과 같은 꼴). 카드를 내면 이 전투 끝까지 켜진다"
    },
    "owner": {
     "type": "string",
     "description": "make — 만든 카드의 주인: self(기본) · other(파티 차례로 다음 아군) · strongestAlly(공격력이 가장 높은 아군 — ▶E23) · 사도 id(데이터.md §19 · §22)"
    },
    "pick": {
     "type": "boolean",
     "description": "spend — 낼 때 소모량을 고른다(1 · 절반 · 전부) · spendShield — 파티 실드를 고른 만큼(절반 · 전부). 쓴 양이 일의 값(perEvent · ofEvent)"
    },
    "half": {
     "type": "boolean",
     "description": "spendShield — 파티 실드 절반 · cardStatus — 카드 값을 절반으로(▶E1 · E17, 데이터.md §22)"
    },
    "ofShield": {
     "type": "boolean",
     "description": "dmg · shield — 일의 값 = 지금 파티 실드(ofEvent 와 같이, ▶E1)"
    },
    "token": {
     "type": "boolean",
     "description": "카드 거르개 — 생성 카드(token)만(▶E11)"
    },
    "hitFx": {
     "$ref": "#/$defs/fxList",
     "description": "dmg — 한 대마다 맞은 그 적에게 도는 효과(▶E3)"
    },
    "carry": {
     "type": "boolean",
     "description": "stack — v 대신 일을 겪은(쓰러진) 적의 그 표식 겹(▶E4)"
    },
    "set": {
     "type": "number",
     "description": "stack · cardStatus — 더하기 대신 그 값으로 정한다(▶E17 · E28)"
    },
    "hitsPer": {
     "type": "string",
     "description": "dmg — 친 횟수 = 이 고유 효과의 겹 + hitsAdd(▶E24)"
    },
    "hitsAdd": {
     "type": "integer",
     "description": "dmg — hitsPer 에 더하는 횟수(▶E24)"
    },
    "loop": {
     "type": "boolean",
     "description": "spend pick — 치는 동안 새로 얻은 겹을 이어 쓴다(max 대까지, 기본 12 — ▶E19)"
    },
    "hpBelow": {
     "type": "number",
     "description": "ifFoe — 고른 적 HP 비율이 이 값 이하면(id hp 와 같다 — ▶E20)"
    },
    "turn": {
     "type": "boolean",
     "description": "perGone — 이번 턴에 사라진 것만(id 면 그 카드만 — ▶E34)"
    },
    "choose": {
     "enum": [
      "priciest"
     ],
     "description": "costMod · cardStatus — 손의 가장 비싼 카드 한 장(▶E45)"
    },
    "keep": {
     "type": "boolean",
     "description": "cardStatus — 붙은 동안 보존(▶E43) · replay — 쪽을 지우지 않음(▶E57)"
    },
    "hitsBy": {
     "enum": [
      "self"
     ],
     "description": "ifFoe — 이번 전투에 이 사도가 그 적을 친 횟수 n 이상(▶E71)"
    },
    "bossRatio": {
     "type": "number",
     "description": "execute — 보스 · 클론에게는 대신 이 비율의 피해(▶E72)"
    },
    "lock": {
     "type": "boolean",
     "description": "stack(set · pick) — 정한 뒤 turns 턴 고정(▶E74)"
    },
    "ofForm": {
     "type": "number",
     "description": "dmg — 이번 변신 중 그 사도가 준 피해 × 이 비율 고정 피해(▶E76)"
    },
    "after": {
     "type": "boolean",
     "description": "ifNth — n번째 이후면(▶E77 정각) · id 가 글 이름"
    },
    "killMore": {
     "type": "boolean",
     "description": "dmg — 치는 동안 처치하면 한 대 더(max 대까지, 기본 12 — ▶E79)"
    },
    "off": {
     "$ref": "#/$defs/fxList",
     "description": "critDmg — 끝날 때 효과(▶E83)"
    },
    "now": {
     "type": "boolean",
     "description": "critNext — 이 카드에 치명 확정(foeStack 이면 그 표식 적을 치는 대만)"
    },
    "foeStack": {
     "type": "string",
     "description": "critNext now — 이 표식이 있는 적을 치는 대만 치명 확정"
    },
    "minCost": {
     "type": "integer",
     "minimum": 0,
     "description": "카드 거르개 · empower(who other) — 비용 이 값 이상인 카드만"
    },
    "knownHits": {
     "type": "integer",
     "minimum": 2,
     "description": "dmg — 아는 수(만년설의 앎)를 하는 적에게는 이 횟수"
    },
    "once": {
     "enum": [
      "foeTurn"
     ],
     "description": "ifFoe known · knownHits — 같은 적에게 그 적 차례마다 한 번만"
    }
   },
   "required": [
    "k"
   ],
   "allOf": [
    {
     "if": {
      "properties": {
       "k": {
        "const": "status"
       }
      }
     },
     "then": {
      "properties": {
       "id": {
        "enum": [
         "취약",
         "약화",
         "손상",
         "피해 감소",
         "반격",
         "표식",
         "잔광",
         "면역",
         "실드 유지",
         "저장",
         "협공",
         "충격",
         "충격파",
         "그을림",
         "회피",
         "공명",
         "실드 보존",
         "행동 둔화",
         "응징",
         "미끄러움",
         "사기",
         "불굴",
         "결의",
         "결정화",
         "고동",
         "칼날 벼리기",
         "형상 강화",
         "탄성",
         "포자증식",
         "고통 각인",
         "근면",
         "계몽",
         "집중",
         "고통",
         "균열",
         "빙벽",
         "절대 무적",
         "열정 약점",
         "순수 약점",
         "광기 약점",
         "냉정 약점",
         "활발 약점",
         "우울 약점",
         "공명 약점",
         "약점 노출",
         "구속",
         "초재생",
         "정신 붕괴",
         "다음 턴 드로우",
         "죽음의 낙인",
         "급속",
         "둔화",
         "끈기",
         "잔불",
         "리듬",
         "기절",
         "은방울"
        ]
       }
      },
      "required": [
       "id",
       "v"
      ]
     }
    }
   ]
  },
  "fxList": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fx"
   }
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^(개전|보존|소멸|증발|종극|주도|유일|연계|천상|신속|분쇄|약점|연결|개막|금기|봉인|회수|연쇄|사용 불가|망각|제거|봉인된 금기|약점 공격|탄환|결속|축복|열정)( [0-9]+)?$"
   }
  },
  "stats": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "hp": {
     "type": "integer"
    },
    "atk": {
     "type": "integer"
    },
    "def": {
     "type": "integer"
    },
    "crit": {
     "type": "integer"
    }
   }
  },
  "oracle": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string"
    },
    "cost": {
     "type": "integer",
     "minimum": 0
    },
    "tags": {
