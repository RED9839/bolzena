# 각 폴더의 .gitignore 가 원작 에셋 · 빌드 산출물을 막는다. 여기서는 공통만.
.DS_Store
Thumbs.db
*.zip

# 파이썬 캐시 · 산출물
__pycache__/
*.pyc

# 원작 목록 · 원작 파생 — 원본 폴더를 통째로 복사해도 들어가지 않게(공개 저장소 규칙)
bolzena-core/Docs/키워드.md
bolzena-core/Docs/키워드.md.meta
bolzena-content-v2/_measure/
bolzena-content-v2/_ref/원작_*.md
bolzena-content-v2/_ref/사도카드그림.*
bolzena-content-v2/_ref/아이콘_목록.md
bolzena-content-v2/_ref/적그림_감사.md
bolzena-content-v2/_ref/적스파인_목록.md
bolzena-runui/Tools~/cardpic_picks.json
bolzena-unity/Captures*/
bolzena-unity/Assets/BolzenaFxData/
bolzena-unity/Assets/BolzenaFxData.meta

# 작업 지시서 · 검사 로그 · 백업 — 공개할 필요 없는 작업 부산물(2026-10-08 정리)
bolzena-content-v2/BRIEF.md
bolzena-content-v2/**/_backup_*
bolzena-content-v2/_gen/rework/chk_*.txt
bolzena-content-v2/_gen/rework/BRIEF_*.md
bolzena-content-v2/_gen/rework/시범_머리.md

# 기록 서버 KV id — 공개 저장소에 올리지 않음
bolzena-unity/Web/wrangler.toml
bolzena-content-v2/_gen/rework/text_*.txt

# 엘다인 측정 부산물(원작 그림 짝 표 사본 포함) — 2026-10-12
bolzena-content-v2/_gen/eldain/measure/

# 검사 · 시뮬 출력 · 빌드 결과물 — 다시 만들 수 있는 작업 부산물(2026-10-12 정리)
**/obj/
**/bin/
*.log
bolzena-content-v2/_gen/**/chk*.txt
bolzena-content-v2/_gen/**/_moved.txt
bolzena-content-v2/_gen/**/sim/*.txt
bolzena-content-v2/_gen/**/pairruns/
bolzena-content-v2/_gen/eldain/out/
bolzena-runui/Tools~/standing_*_report.txt
bolzena-runui/Tools~/standing_*_check.txt
# 측정 원자료 · 사람 기록 집계(2026-10-13)
bolzena-content-v2/_gen/**/원자료/
bolzena-content-v2/_gen/g4/측정/*.tsv
