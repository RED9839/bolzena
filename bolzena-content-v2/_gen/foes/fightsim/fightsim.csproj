<Project Sdk="Microsoft.NET.Sdk">
  <!-- 적 리워크 측정 도구 — 빌드된 bz(Dev.dll)를 참조한다. 엔진을 다시 빌드했으면 이것도 다시 빌드. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dev"><HintPath>C:/projects/bolzena-core/Tools~/Dev/bin/Release/net8.0/Dev.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>C:/projects/bolzena-core/Tools~/Dev/lib/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
