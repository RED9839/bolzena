<Project Sdk="Microsoft.NET.Sdk">
  <!-- 적 리뉴얼(2026-10-10) 마을 고정 측정 — 코어 소스를 직접 컴파일한다(공유 bz 를 다시 빌드하지 않음 · obj 도 따로).
       빌드: dotnet build -c Release -o <임시 폴더>  (그 시점 코어 작업 트리 그대로 — 측정 문서에 코어 상태를 적을 것) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414;CS8632</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="C:/projects/bolzena-core/Runtime/**/*.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>C:/projects/bolzena-core/Tools~/Dev/lib/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
